<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MiraiCast Lab requests the MINIMUM set of permissions needed for its experiments.
      The app has NO internet permission on purpose: it never uploads anything (spec section 6).
      Every permission below is explained to the tester at runtime before it is requested.
    -->

    <!-- Network / Wi-Fi Direct observation (section 2.1, 2.3) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Wi-Fi P2P peer discovery needs location up to API 32, NEARBY_WIFI_DEVICES from API 33. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- MediaProjection experiment (section 2.4) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional: audio capture characterisation (section 2.5). App starts fine without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Optional: Bluetooth HID baseline test (section 2.6C). Never used to pair silently. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Feature declarations are all optional: the app must run on any device and report
         UNSUPPORTED rather than refuse to install. -->
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.midi" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiraiCastLab"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:theme="@style/Theme.MiraiCastLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Renders the diagnostic test scene onto a secondary (external) display when one exists. -->
        <activity
            android:name=".scene.PresentationHostActivity"
            android:exported="false"
            android:label="@string/scene_title"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:theme="@style/Theme.MiraiCastLab" />

        <service
            android:name=".projection.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
